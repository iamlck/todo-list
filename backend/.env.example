# Copy to backend/.env and adjust. backend/.env is gitignored.

# Matches docker-compose.yml (host port 5433, so it never collides with a
# Postgres already running locally on 5432).
DATABASE_URL=postgresql+psycopg://tracker:tracker@localhost:5433/tracker

# Generate a real one:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# Comma-separated origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173
